{
  "manifest_version": 3,
  "name": "NBS Download Manager Integration",
  "short_name": "NBS DM",
  "version": "1.0.0",
  "description": "Sends browser downloads, magnet links and .torrent files to NBS Download Manager for fast downloads and torrent streaming.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "NBS Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["downloads", "cookies", "contextMenus", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nbs-download-manager@nbs.local",
      "strict_min_version": "121.0"
    }
  }
}

{
  "name": "nbs-download-manager",
  "private": true,
  "version": "1.0.0",
  "description": "NBS Download Manager — Rust + Tauri segmented download manager",
  "scripts": {
    "tauri": "tauri",
    "dev": "cargo build -p nbs-native-host && tauri dev",
    "build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "icons": "tauri icon assets/logo.svg -o src-tauri/icons"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}

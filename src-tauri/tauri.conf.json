{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NBS Download Manager",
  "mainBinaryName": "nbs-download-manager",
  "version": "1.0.0",
  "identifier": "com.nbs.downloadmanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NBS Download Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast segmented download manager",
    "linux": {
      "deb": { "desktopTemplate": "linux/nbs-download-manager.desktop" },
      "rpm": { "desktopTemplate": "linux/nbs-download-manager.desktop" }
    },
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "Torrent file",
        "description": "BitTorrent file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
